{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Centsmith",
  "version": "0.1.0",
  "identifier": "com.williamhatcher.centsmith",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../loader",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Centsmith",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/backend/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "William Hatcher",
    "copyright": "Copyright © 2026",
    "category": "Finance",
    "windows": {
      "signCommand": {
        "cmd": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../packaging/sign-windows.ps1",
          "-FilePath",
          "%1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDOTgzQTMwNkREMzMzNjUKUldSbE05TnRNRHFZekVtdmUvQ2tORHZjVURYQ1YyWkdnMkVIWWhGM1JjeFhVdHZFMHZ0Y0ZhMHYK",
      "endpoints": [
        "https://github.com/williamhatcher4/centsmith_releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
