# Copy this file to .env and fill in values before the first run.
# .env is gitignored — your credentials stay on your machine.

# Login credentials for the app. Pick anything you'll remember.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Used to sign your login session. Leave as __AUTO__ and start.ps1 will
# generate a random value the first time you run the app.
SECRET_KEY=__AUTO__

# Failed-login lockout settings.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
