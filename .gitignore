# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Backend
backend/.venv/
backend/.env
backend/.env.*
!backend/.env.example

# Local database
/credit_tracker.db
/centsmith.db
/centsmith-e2e.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal

# E2E test artifacts
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.playwright-cli/
.playwright/

# Runtime logs and local metadata
*.log
*.pid
runtime.json

# Frontend
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.env
frontend/.env.*

# Packaging - build artifacts, never source
packaging/build/
packaging/dist/
packaging/*.patched.spec
# PyArmor falls back to ./dist relative to CWD if its cfg hasn't been applied
# yet (e.g. a stand-alone `pyarmor gen` run, or intermediate output before the
# repacked spec settles). Always gitignored.
/dist/
*.pfx
*.p12
*.pem
*.key
*.key.pub
# DPAPI-encrypted secret blob — only ever lives in %APPDATA%, but ignore
# anywhere in the tree so it can't be checked in by accident.
*.dpapi
.tauri/
.pyarmor/
pyarmor.*.log

# Tauri / Rust build output
desktop/src-tauri/target/

# Tauri staged resources (populated by build.ps1, not source)
desktop/src-tauri/resources/backend/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.vs/

# Local assistant/debug workspace files
.claude/
DEBUG.md
AI-Context/
AGENTS.md
CLAUDE.md
commands_to_run_tests.md

# Loose data files dropped in the repo root (statements, exports, etc.)
/*.csv
/*.xls
/*.xlsx

#vault
.obsidian/
*.canvas